# Copy this file to ".env" in this same folder and fill in your real key.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ---- Optional: daily practice reminder emails (see server/reminders.js) ----
# All three must be set (plus FIREBASE_SERVICE_ACCOUNT_JSON) before any email is sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Echoly <hello@yourdomain.com>
# CRON_SECRET=any-long-random-string
# EMAIL_MAILING_ADDRESS=Your postal mailing address (required in emails under Canada's CASL)
# REMINDER_HOUR=18
